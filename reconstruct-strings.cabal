cabal-version:      3.0
name:               reconstruct-strings
version:            0.1.0
synopsis:           DNA sequence reconstruction using greedy overlap assembly
description:
  Reconstructs contiguous DNA sequence contigs from short overlapping read
  fragments using a pure, total greedy overlap assembler.

homepage:
  https://github.com/frankhjung/haskell-reconstruct-strings#readme

bug-reports:
  https://github.com/frankhjung/haskell-reconstruct-strings/issues

author:             Frank H Jung
maintainer:         frankhjung@linux.com
copyright:          Copyright © 2026 Frank H Jung
license:            BSD-3-Clause
license-file:       LICENSE
category:           Bioinformatics
extra-source-files:
  docs/FunctionalGreedyOverlapAssemblerSpecification.md
  docs/GLOSSARY.md
  docs/ReconstructingCompleteDNAStrandFromShortFragments.md
  README.md

common shared-properties
  default-language:   Haskell2010
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints

  default-extensions:
    BangPatterns
    DerivingStrategies
    GeneralizedNewtypeDeriving
    LambdaCase
    OverloadedStrings

source-repository head
  type:     git
  location: https://github.com/frankhjung/haskell-reconstruct-strings

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Assembler
    Assembler.Types

  build-depends:
    , base  ^>=4.18.3
    , text  ^>=2.0

executable reconstruct-strings
  import:          shared-properties
  hs-source-dirs:  app
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts -with-rtsopts=-N
  autogen-modules: Paths_reconstruct_strings
  other-modules:   Paths_reconstruct_strings
  build-depends:
    , base                  ^>=4.18.3
    , optparse-applicative  ^>=0.18
    , reconstruct-strings
    , text                  ^>=2.0

test-suite test
  import:             shared-properties
  hs-source-dirs:     test
  main-is:            Spec.hs
  type:               exitcode-stdio-1.0
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
  other-modules:      AssemblerSpec
  build-tool-depends: hspec-discover:hspec-discover ^>=2.11
  build-depends:
    , base                 ^>=4.18.3
    , hspec                ^>=2.11
    , QuickCheck           ^>=2.14
    , reconstruct-strings
    , text                 ^>=2.0
